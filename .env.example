# Copy to .env and fill in. Never commit .env.

# PayPal SANDBOX app (Developer Dashboard > Apps & Credentials > your app).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# live (default) uses the PayPal sandbox. mock uses the bundled demo data in data/paypal_mock.json:
# no credentials, no network, no buyer approval. In live mode, subscriptions still awaiting approval
# (APPROVAL_PENDING) also fall back to the demo data, clearly labelled.
PAYPAL_MODE=live

# Optional: email of your sandbox PERSONAL (buyer) account, used when seeding demo subscriptions.
PAYPAL_BUYER_EMAIL=
# Optional: override the "manage your subscriptions" link shown to the user.
PAYPAL_MANAGE_URL=

# Anthropic (AI explanations, message drafts and Q&A). Leave empty to use the built-in templates.
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5 (cheaper).
SUBSWEEP_MODEL=
# Optional: set to off to disable all model calls.
SUBSWEEP_AI=
# Optional: where the AI audit log is written (default logs/ai_audit.jsonl).
SUBSWEEP_AI_LOG=
